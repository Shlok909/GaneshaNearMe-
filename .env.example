# Browser Maps JavaScript API key: restrict to your website and Maps JavaScript API.
# Set actual values in ignored .env.local.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server-only Routes API key. Restrict to Routes API; never add NEXT_PUBLIC_.
GOOGLE_ROUTES_API_KEY=
# Supabase Auth, Database and Storage: project origin and publishable key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
